@model IEnumerable<Presentation.Areas.Administration.Models.LocationModel>
@using GridMvc.Html
@{
    ViewBag.Title = "Location Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h4>@ViewBag.Title</h4>
<div class="form-horizontal">
    <div class="form-group">
        <div class="col-lg-offset-11">
            <input type="button" value="Add New" class="btn btn-primary" onclick="location.href='@Url.Action("frmLocation","Location")'" />
        </div>
    </div>
    <div class="form-group">
        <div class="panel panel-default">
            <div class="panel-body">
                @Html.Grid(Model).Columns(columns =>
           {
               columns.Add()
               .Encoded(false)
               .Sanitized(false)
               .SetWidth(30)
               .RenderValueAs(o => Html.ActionLink("Edit", "frmLocation", "Location", new { theParameter = Application.Common.clsEncryptDecrypt.Encrypt(o.Id.ToString()) }, null));

               columns.Add(c => c.Name).Titled("Location Name").SetWidth(100);
               columns.Add(c => c.OrganizationName).Titled("Organization Name").SetWidth(100);
               columns.Add(c => c.Code).Titled("Code").SetWidth(50);
           }).EmptyText("No Data Found.").Filterable(true).Sortable(true).WithPaging(20)

            </div>
        </div>
    </div>
</div>
