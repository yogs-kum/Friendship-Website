@model Presentation.Areas.Profile.Models.NDUserProfile


@using (@Html.BeginForm("SaveUpdateActivityPreferences", "Profile", FormMethod.Post, new { @class = "row g-3 needs-validation ps-lg-4" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)
<div class="col-12">
    @{ var id = string.Join(",", Model.theActivityPreferences.SelectedMultiMovieId);}

    <input type="hidden" id="hfSelectedMultiMovieId" name="hfSelectedMultiMovieId" value="@id" />
    
    <label for="validationCustom01" class="form-label">Watching a movie?</label>
    <div class="row row-cols-4">
        @foreach (var item in ViewBag.Movie)
        {
            var IsSelected = "";
            if (Model.theActivityPreferences.SelectedMultiMovieId != null)
            {
                if (Model.theActivityPreferences.SelectedMultiMovieId.Contains(Convert.ToInt32(item.Value)))
                {
                    IsSelected = "checked";
                }
            }
            <div class="mb-1"><input type="checkbox" value="@item.Value" name="movie" class="form-check-input ms-2 movie" @IsSelected> @item.Text</div>
        }

    </div>
</div>
    <div class="col-12">
        <label for="validationCustom01" class="form-label">Having tea/coffee</label>
        <div>
            @Html.RadioButtonFor(m => m.theActivityPreferences.Q2_Having_Tea_Coffee, "Yes", new { @class = "form-check-input ms-2", @checked = "checked" }) Yes
            @Html.RadioButtonFor(m => m.theActivityPreferences.Q2_Having_Tea_Coffee, "No", new { @class = "form-check-input ms-2" }) No
            @Html.ValidationMessageFor(m => m.theActivityPreferences.Q2_Having_Tea_Coffee, "", new { @class = "text-danger" })

        </div>
    </div>
    <div class="col-12">
        <label for="validationCustom01" class="form-label">Going to a bar/sports bar</label>
