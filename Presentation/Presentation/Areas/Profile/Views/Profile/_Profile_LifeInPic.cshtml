            <input name="ddlProfileSection2" type="hidden" value="@ViewBag.LifePic2Section">
            <script>
                var LifePicSection = "@ViewBag.LifePic2Section";
                if (LifePicSection != null && parseInt(LifePicSection) > 0) {
                    var ele = document.getElementById("ddlProfileSection2");
                    ele.value = LifePicSection;
                    ele.setAttribute("disabled", "disabled");
                }

            </script>
        </div>
        <div class="col-md-4 p-4">
