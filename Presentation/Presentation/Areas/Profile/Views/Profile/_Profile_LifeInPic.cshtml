@model Presentation.Areas.Profile.Models.NDUserProfile

@using (Html.BeginForm("SaveUpdateLifeInPic", "Profile", FormMethod.Post, new { enctype = "multipart/form-data", @id= "frmLifeInPic", @class = "" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)
    <div class="row g-3 needs-validation ps-lg-4">
        <div class="col-md-4 p-4">
            <div class="fav-pic mb-4" style="background-image:url(@ViewBag.LifePic1);">
                <input name="LifePic1Name" type="hidden" value="@ViewBag.LifePic1Name">                
                <input type="file" id="FUSectionSelector1" name="FUSectionSelector1" hidden accept=".png,.jpeg,.jpg" />
                <label for="FUSectionSelector1" class="add-fav-pic-btn"></label>
            </div>            
            @Html.DropDownList("ddlProfileSection1", new SelectList((IEnumerable<SelectListItem>)ViewData["ProfileSection1"], "Value", "Text"), "Choose...", new { @class = "form-select mb-2" })
            <input id="SectionAbout1" name="SectionAbout1" type="text" class="form-control" value="@ViewBag.LifePic1About" placeholder="About Picture">
            <input name="ddlProfileSection1" type="hidden" value="@ViewBag.LifePic1Section">
            <script>
                var LifePicSection = "@ViewBag.LifePic1Section";
               
                if (LifePicSection != null && parseInt(LifePicSection) > 0) {
                    var ele = document.getElementById("ddlProfileSection1");
                    ele.value = LifePicSection;
                    ele.setAttribute("disabled", "disabled");
                }
               

            </script>
        </div>
        <div class="col-md-4 p-4">
            <div class="fav-pic mb-4" style="background-image:url(@ViewBag.LifePic2);">
