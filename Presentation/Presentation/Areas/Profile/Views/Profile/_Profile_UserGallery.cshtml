        @*<img src="~/Content/assets/images/blank-user.png" class="w-100 h-auto" alt="User Name">*@
        <img src="@Session["ProfilePic"]" class="w-100 h-auto" alt="User Name">
    </div>
    <span class="add-user-pic-btn"></span>
</div>

<script>
    var theDivCounter = @ViewBag.DivCounter;
    var ProfileImageArr = [];
    var base64String = "";
    var ImgBase64StringResult = "";
    var theImgName;
    var theImgIsProfile;

    function onlyOne(checkbox) {
        //var checkboxes = document.getElementsByName('check')
        var checkboxes = document.getElementsByName('check')
        checkboxes.forEach((item) => {
            if (item !== checkbox) {
                item.checked = false;
                for (i = 0; i < ProfileImageArr.length; i++) {
                    if (checkbox.id != ProfileImageArr[i][1]) {
                        ProfileImageArr[i][2] = 0;
                    }
                }
            }
            else {
                for (i = 0; i < ProfileImageArr.length; i++) {
                    if (checkbox.id == ProfileImageArr[i][1]) {
                        ProfileImageArr[i][2] = 1;
                    }
                }
            }
        })
    }

    function DeleteDiv(theDiv, theImage) {
        var item = 'PicDiv' + theDiv.toString();
        document.getElementById(item).remove();
        for (i = 0; i < ProfileImageArr.length; i++) {
            if (theImage.id == ProfileImageArr[i][1]) {
                ProfileImageArr.splice(i, 1);
            }
        }
    }


    function previewImage() {
        var total_file = document.getElementById("theFileUpload").files.length;
        for (var i = 0; i < total_file; i++) {
            var theHtml = "<div id = 'PicDiv" + theDivCounter.toString() + "' class='p-2' > <div class='rounded-3 position-relative overflow-hidden box'><img src='" + URL.createObjectURL(event.target.files[i]) + "' alt='" + event.target.files[i].name + "' class='w-100 h-auto my-match-frnd'>";
            theHtml += "<button id = '" + event.target.files[i].name + "' class='delete-btn' onclick='DeleteDiv(" + theDivCounter.toString() + ",this)'></button><input id ='" + event.target.files[i].name + "' type='checkbox' value='1' name='check' onclick='onlyOne(this)' class='form-check-input default-profile radio'></div></div>";
            $('#FilePreview').append(theHtml);
            theDivCounter++;

            const file = event.target.files[i];
            const reader = new FileReader();
            reader.addEventListener("load", () => {
                ProfileImageArr.push([reader.result, file.name, 0]);
            })
            reader.readAsDataURL(file);

        }
        //ProfileImageArr.push([ImgBase64StringResult, event.target.files[i].name.toString(), 0]);
    }

    function ImgLoadfromDB(img, imgName, isProfile) {
        const file = img.src;
        theImgName = imgName;
        theImgIsProfile = isProfile;
        var xhr = new XMLHttpRequest();
        xhr.open("GET", file);
        xhr.responseType = "blob";
        xhr.onload = function (e) {
            const theFile = this.response;
            const reader = new FileReader();
            reader.addEventListener("load", () => {
                ProfileImageArr.push([reader.result, imgName, isProfile]);
                
            })
            reader.readAsDataURL(theFile)
        };
        xhr.send();
    }

    function response(e) {
        const theFile = this.response;
        const reader = new FileReader();
        reader.addEventListener("load", () => {
            ProfileImageArr.push([reader.result, theImgName, theImgIsProfile]);
        })
        reader.readAsDataURL(theFile)

    }


    function SaveCall() {
        
        var url = "/Profile/Profile/Profile_UserGallerySave";
        var fd = new FormData();
        fd.append('ProfileArray', ProfileImageArr);
        $.ajax({
            type: "POST",
            processData: false,
            contentType: false,
            url: url,
            data: fd,
            success: function () {
                alert("Profile images updated.");
                window.location = "";
            }, error: function () { alert("Error in User Gallery Call"); }
        })
    }
</script>
