        $(document).ready(function () {

            $('#tabs li:not(:first)').addClass('inactive');
            $('.tab').hide();
            $('.tab:first').show();

            $('#tabs li').click(function () {
                var t = $(this).attr('id');
                if ($(this).hasClass('inactive')) { //this is the start of our condition
                    $('#tabs li').addClass('inactive');
                    $('#tabs li').removeClass('active');
                    $(this).removeClass('inactive');
                    $(this).addClass('active');

                    $('.tab').hide();
                    $('#' + t + 'C').fadeIn('slow');

                    $.ajax({
                type: "GET", dataType: "json", url: '@Url.Action("SetEditProfileActiveTab","Profile")',
                        data: { theActiveTab: t.replace("tab","").toString() }, success: function (response) { }, error: function () { }
            })
                }
            });



            $("#frmLifeInPic input[type='file']").change(function () {
                var input = $(this);
                    const file = this.files[0];
                    if (file) {
                        let reader = new FileReader();
                        reader.onload = function (event) {
                            $(input).parent(".fav-pic").css("background-image", 'url(' + event.target.result + ')');
                        }
                        reader.readAsDataURL(file);
                    }
            });


            // Enable Live Search.
            $('#ddlMusic').attr('data-live-search', true);
            //// Enable multiple select.
            $('#ddlMusic').attr('multiple', true);
            $('#ddlMusic').attr('data-selected-text-format', 'count');
            $('.selectMusic').selectpicker(
                {
                    width: '100%',
                    title: '- [Choose Multiple Musics] -',
                    //style: 'btn-warning',
                    size: 6,
                    iconBase: 'fa',
                    tickIcon: 'fa-check'
                });


        });


