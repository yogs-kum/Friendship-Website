    <script>
            function GetCountryState() {
            var theUrl = '@Url.Action("GetCountryState", "Profile")';
            var theCountryId = $("#ddlCountry").val();
            $.ajax({
                type: "GET", dataType: "json", url: theUrl,
                data: { theCountryId: theCountryId }, success: function (response) {
                    $("#ddlState").empty();
                    $("#ddlState").append($("<option></option>").val("0").html("Choose..."));
                    $.each(response, function (index, item) {
                        $("#ddlState").append($("<option></option>").val(item['Value']).html(item['Text']));
                    })
                    $(document).ready(function () { $("#ddlState").val(@ViewBag.StateId); })
                }, error: function () { alert("Error in Call"); }
            })
        }
    </script>

