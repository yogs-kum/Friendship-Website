    <script type="text/javascript">

        debugger;
        var arrMovie = $('#hfSelectedMultiMovieId').val().split(',');
        var arrCuisine = $('#hfSelectedMultiCuisineId').val().split(',');
        $(document).ready(function () {

            $('.movie').click(function () {

                if ($(this).is(":checked")) {
                    var val = $(this).val();
                    arrMovie.push(val);
                    $("#hfSelectedMultiMovieId").val(arrMovie);
                }


                if ($(this).not(':checked').length) {
                    var val = $(this).val();
                    const newArr = arrMovie.filter(e => e !== val);
                    
                    $("#hfSelectedMultiMovieId").val(newArr);
                    for (var i in arrMovie) {
                        var val = $(this).val();
                        if (arrMovie[i] == val) {
                            arrMovie.splice(i, 1);
                            break;
                        }
                    }
                }

            });


            $('.cuisine').click(function () {

                if ($(this).is(":checked")) {
                    var val = $(this).val();
                    arrCuisine.push(val);
                    $("#hfSelectedMultiCuisineId").val(arrCuisine);
                }

                if ($(this).not(':checked').length) {

                    var val = $(this).val();
                    const newArr = arrCuisine.filter(e => e !== val);
                    $("#hfSelectedMultiCuisineId").val(newArr);
                    for (var i in arrCuisine) {
                        if (arrCuisine[i] == val) {
                            arrCuisine.splice(i, 1);
                            break;
                        }
                    }
                }


            });


