<script type="text/javascript">
	Dropzone.options.dropzoneForm =
	{
		addRemoveLinks: true,
		maxFiles: 10,
		init: function () {
			this.on("complete", function (data) {
				//var res = eval('(' + data.xhr.responseText + ')');
				var res = JSON.parse(data.xhr.responseText);
			});
		}
	};

	function UploadPhoto(profilesectionid, profileid) {
		$("#modProfilePics").modal("show");
		$("#ProfileSectionId").val(profilesectionid);
		$("#ProfileId").val(profileid);
		
	}

	$(function () {
		// Multiple images preview in browser
		var imagesPreview = function (input, placeToInsertImagePreview) {

			if (input.files) {
				var filesAmount = input.files.length;

				for (i = 0; i < filesAmount; i++) {
					var reader = new FileReader();

					reader.onload = function (event) {
						$($.parseHTML('<img style="height:90px; width:90px;">')).attr('src', event.target.result).appendTo(placeToInsertImagePreview);
					}

					reader.readAsDataURL(input.files[i]);
				}
			}

		};

		$('#btnUPload').on('change', function () {
			imagesPreview(this, 'div.gallery');
		});
	});

	
</script>
<div class="container photouploader">
	<div class="form-horizontal">
		<h3>My Life - In Pictures</h3>
