				@*onclick="UploadPhoto('@Application.Common.clsEncryptDecrypt.Encrypt(row["ProfileSectionId"].ToString())', '@Application.Common.clsEncryptDecrypt.Encrypt(row["ProfileID"].ToString())')"*@
