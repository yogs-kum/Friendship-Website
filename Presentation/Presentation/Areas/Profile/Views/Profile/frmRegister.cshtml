<script type="text/javascript">
	$(document).ready(function () {
		$('#txtPhone').keyup(function (e) {
			ValidateUser();
			//NumericOnly(e);
		});
		$('#txtPhone').keydown(function (e) {
			ValidateUser();
			//NumericOnly(e);
		});
		$("#txtPhone").bind("paste", function (e) {
			e.preventDefault();
		});
		$("#txtPhone").bind('keypress', function (e) {
			if (e.keyCode == '9' || e.keyCode == '16') {
				return;
			}
			var code;
			if (e.keyCode) code = e.keyCode;
			else if (e.which) code = e.which;
			if (e.which == 46)
				return false;
			if (code == 8 || code == 46)
				return true;
			if (code < 48 || code > 57)
				return false;
		}
		); $('#txtPinCode').keyup(function (e) {
			ValidateUser();
			//NumericOnly(e);
		});
		$('#txtPinCode').keydown(function (e) {
			ValidateUser();
			//NumericOnly(e);
		});
		$("#txtPinCode").bind("paste", function (e) {
			e.preventDefault();
		});
		$("#txtPinCode").bind('keypress', function (e) {
			if (e.keyCode == '9' || e.keyCode == '16') {
				return;
			}
			var code;
			if (e.keyCode) code = e.keyCode;
			else if (e.which) code = e.which;
			if (e.which == 46)
				return false;
			if (code == 8 || code == 46)
				return true;
			if (code < 48 || code > 57)
				return false;
		}
		);
		var CntryId = $("#ddlCountry").val();
		// var Demographic = '';
		if (CntryId != "") {
			// GetCountryState();
		}

		if ($('#hdnNextTab').val() == "ProfilePics") {
			openLifeMyPictureView(1);
		}

		else if ($('#hdnNextTab').val() == "ProfileCharStr") {
			openSpecificInterestsView(1);
		}
		else if ($('#hdnNextTab').val() == "ProfileInter") {
			openCharacterStrengthsView(1);
		}
		else if ($('#hdnNextTab').val() == "ProfileTrait") {
			openNeurodiverseStrengthsView(1);
		}
		else {
			ShowDemographic();
		}

	});

    function GetCountryState() {
        var theUrl = '@Url.Action("GetCountryState", "Profile")';
        var theCountryId = $("#ddlCountry").val();
        $.ajax({
            type: "GET", dataType:"json", url: theUrl,
            data: { theCountryId: theCountryId }, success: function (response) {
                $("#ddlState").empty();
                $.each(response, function (index, item) {
                    $("#ddlState").append($("<option></option>").val(item['Value']).html(item['Text']));
                })
                $(document).ready(function () { $("#ddlState").val(@ViewBag.StateId);})
            }, error: function () { alert("Error in Call"); }
        })
    }

	function ValidateUser(return_val) {
		event = event || window.event || event.srcElement;
		var return_val = true;
		if ($('#txtFirstName').val().trim() == '') {
			$('#txtFirstName').next('span').text('Please Enter first name').show();
			return_val = false;
		} else {
			$('#txtFirstName').next('span').hide();
		}
		if ($('#txtLastName').val().trim() == '') {
			$('#txtLastName').next('span').text('Please enter last name').show();
			return_val = false;
		}
        if ($('#txtNickName').val().trim() == '') {
            $('#txtNickName').next('span').text('Please enter nick name').show();
            return_val = false;
        }else {
			$('#txtLastName').next('span').hide();
		}
		if ($('#ddlCountry').val().trim() == '') {
			$('#ddlCountry').next('span').text('Please select country').show();
			return_val = false;
		} else {
			$('#ddlCountry').next('span').hide();
		}
		if ($('#ddlState').val().trim() == '') {
			$('#ddlState').next('span').text('Please select state').show();
			return_val = false;
		} else {
			$('#ddlState').next('span').hide();
		}
		if ($('#txtCity').val().trim() == '') {
			$('#txtCity').next('span').text('Please enter city').show();
			return_val = false;
		} else {
			$('#txtCity').next('span').hide();
		}
		if ($('#txtPinCode').val().trim() == '') {
			$('#txtPinCode').next('span').text('Please enter zipcode').show();
			return_val = false;
		} else {
			$('#txtPinCode').next('span').hide();
		}
		if ($('#txtPhone').val().trim() == '') {
			$('#txtPhone').next('span').text('Please enter phone no.').show();
			return_val = false;
		} else {
			$('#txtPhone').next('span').hide();
		}
		return return_val;
	};
	function SavePostData() {
		var isValid = ValidateUser(0);
		if (isValid) {
			$('#frmContactUs').submit();
		}

	}
	function ShowDemographic() {
		$('#profileData').show();
		$('#mylifeinPicture').hide();
        $('#SpecificInterests').hide();
        $('#characterStrengths').hide();
        $('#beFriendsWithMe').hide();
		$('#NeurodiverseStrengths').hide();
		$('#Masker').hide();
        $('#step_1').addClass('active');
        $('#step_2').removeClass('active');
        $('#step_3').removeClass('active');
        $('#step_4').removeClass('active');
        $('#step_5').removeClass('active');
		$('#step_6').removeClass('active');
		$('#step_7').removeClass('active');
            }

    function openLifeMyPictureView(partialViewToInsert) {
        var userID = $('#UserId').val();
        var obj = {
            id: '_myLifeMyPicture',
           // UserID: $('#UserId').val()//'M7VuQHORs+4='
             UserID: userID
        };
        $.ajax({
            url: '@Url.Action("_myLifeMyPicture", "Profile")',
            data: obj,
            type: "POST",
            success: function (data) {
                $('#mylifeinPicture').html(data);
                $('#mylifeinPicture').show();
                $('#profileData').hide();
                $('#beFriendsWithMe').hide();
                $('#SpecificInterests').hide();
				$('#characterStrengths').hide();
				$('#NeurodiverseStrengths').hide();
                $('#Masker').hide();
				$('#step_1').removeClass('active');
                $('#step_2').addClass('active');
                $('#step_3').removeClass('active');
                $('#step_4').removeClass('active');
                $('#step_5').removeClass('active');
				$('#step_6').removeClass('active');
				$('#step_7').removeClass('active');

            }
        });
    }

