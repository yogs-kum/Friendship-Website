     function openSpecificInterestsView(partialViewToInsert) {
        $.ajax({
            url: '@Url.Action("_IntersetcharacterNeuro", "Profile")',
            data: { id: partialViewToInsert},
            type: "POST",
            success: function (data) {
                $('#SpecificInterests').html(data);

                $('#SpecificInterests').show();
				$('#profileData').hide();
				$('#mylifeinPicture').hide();
                $('#beFriendsWithMe').hide();
				$('#characterStrengths').hide();
				$('#NeurodiverseStrengths').hide();
