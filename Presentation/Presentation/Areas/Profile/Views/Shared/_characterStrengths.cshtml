
@model Presentation.Areas.Profile.Models.Mst_Strengths
@{
    ViewBag.Title = "Masker";
    // Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

<div>
	@using (Html.BeginForm("PostDataCharacterStrength", "Profile", FormMethod.Post, new { id = "frmContactUs10", name = "frmContactUs10", enctype = "multipart/form-data" }))
	{
		<input type="hidden" id="ProfileId" name="ProfileId" value="@Application.Common.clsEncryptDecrypt.Encrypt(ViewBag.ProfileID.ToString())" />
		<div class="st-row">

			<div class="st-row st-direction-column st-flex">
				@foreach (var questions in ViewBag.strengthsLists)
				{

					<div class="st-row st-middle pf-field-cntnr" style="margin-bottom:13px;">
						@*<input type="text" style="width: 278px;margin-left: 9px;" />*@
						@*<input type="checkbox" id=@questions.Id name=@questions.Id>*@
						@if (questions.StrengthId)
						{
							<input type="checkbox" id=@questions.Id name="@questions.Id" checked>
						}
						else
						{
							<input type="checkbox" id=@questions.Id name="@questions.Id">
						}
						<lable>@questions.Name</lable>
					</div>
				}
			</div>

			<div class="st-row st-direction-column st-flex">
				@foreach (var questions in ViewBag.strengthsLists)
				{

					<div class="st-row st-middle pf-field-cntnr" style="margin-bottom:13px;">
						@*<input type="text" style="width: 278px;margin-left: 9px;" />*@
						@*<input type="checkbox" id=@questions.Id name=@questions.Id>*@
						@if (questions.StrengthId)
						{
							<input type="checkbox" id=@questions.Id name="@questions.Id" checked>
						}
						else
						{
							<input type="checkbox" id=@questions.Id name="@questions.Id">
						}
						<lable>@questions.Name</lable>
					</div>
				}
			</div>

		</div>

		<div class="pf-field-cntnr st-row st-center" style="padding-top:25px;">
			<input type="submit" value="Next &nbsp;&nbsp;&#10095;" class="btn-l btn-primary btn-next" />
		</div>
	}
</div>

