    @using Presentation.Areas.Profile.Models;
    @model LnkProfilePhotos
    @{
        ViewBag.Title = "About Me";
        // Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
        Model.LinkPhotos = Model.LinkPhotos.OrderByDescending(x => x.LinkID).ToList();
        var Pic1 = Model.LinkPhotos.Where(x => x.ProfileSectionId == "10").FirstOrDefault();
        var PicName = System.Configuration.ConfigurationManager.AppSettings["ProfileSection"] + "default-upload.png";
        if (Pic1 != null)
        {
            Model.LinkPhotos.Remove(Pic1);
            if (string.IsNullOrEmpty(Pic1.PicName))
            {
                Pic1.PicName = System.Configuration.ConfigurationManager.AppSettings["ProfileSection"] + "default-upload.png";
            }
            else
            {
                Pic1.PicName = "../../" + System.Configuration.ConfigurationManager.AppSettings["ProfilePhotos"] + "/" + Pic1.ProfileID + "/" + Pic1.PicName;
            }
        }
        else
        {
            Pic1 = new LnkProfileData();
            Pic1.PicName = System.Configuration.ConfigurationManager.AppSettings["ProfileSection"] + "default-upload.png";
            Pic1.LinkID = "0";
        }

        var PicList = Model.LinkPhotos;

    }
    <div>

        <div style="text-align:center;margin-bottom:20px;">
            <h3>Include personal photos to tell your story, visually</h3>
        </div>

		<div class="st-row st-wrap">

			<div class="life-in-pic-box">
				<div class="st-pdg proficepic">
					@using (Html.BeginForm("UploadProfilePhoto", "Profile", FormMethod.Post, new { id = "frmContactUs1", name = "frmContactUs1", enctype = "multipart/form-data" }))
					{
						<div onclick="UploadPhoto('1')" class="img-input">
							@try
							{
								if (string.IsNullOrEmpty(PicList[0].PicName))
								{
									PicName = System.Configuration.ConfigurationManager.AppSettings["ProfileSection"] + "default-upload.png";
								}
								else
								{
									PicName = "../../" + System.Configuration.ConfigurationManager.AppSettings["ProfilePhotos"] + "/" + PicList[0].ProfileID + "/" + PicList[0].PicName;

								}
							}
							catch { }
							<div id="divimg_1" class="img-box">
								<img src="@PicName" height="150" width="150" id="img_1">
							</div>
						</div>
						<input type="file" accept="image/*" style="display:none" id='btnUPload_1' onchange="imagesPreview(this, 'img_1')" />
						<div class="detail-box">
							@Html.DropDownList("ProfileSectionId", new SelectList((IEnumerable<SelectListItem>)ViewData["MstProfileSections"], "Value", "Text", PicList[0].SectionID), "Select Name", new { @class = "pf-input", @id = "ProfileSectionId", @name = "ProfileSectionId" })
							<input type="text" id="PicDescription" name="PicDescription" class="pf-input" placeholder="About Picture" value="@PicList[0].PicDescription">
						</div>
						<input type="hidden" id="ProfileId" name="ProfileId" value="@Application.Common.clsEncryptDecrypt.Encrypt(Model.profilePhoto.ProfileId.ToString())" />
						<input type="hidden" id="LinkID" name="LinkID" value="@Application.Common.clsEncryptDecrypt.Encrypt(PicList[0].LinkID.ToString())" />
					}
				</div>
			</div>

