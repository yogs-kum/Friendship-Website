    //}

    function SavePics() {
	    $('.proficepic').find('form').each(function (i, el) {
		    var ab = $(this).find('input[type="file"]');
		    var fileUpload = ab.get(0);
		    var files = fileUpload.files;

		    // Create FormData object
		    var fileData = new FormData();

		    if (files.length > 0) {

			    if (window.FormData !== undefined) {

				    // Looping over all files and add it to FormData object
				    for (var i = 0; i < files.length; i++) {
					    fileData.append(files[i].name, files[i]);
				    }

				    // Adding one more key to FormData object
				    //string ProfileSectionId, string ProfileId, string PicDescription
				    fileData.append('ProfileSectionId', $(this).find('[name="ProfileSectionId"]').val());
				    fileData.append('ProfileId', $(this).find('[name="ProfileId"]').val());
				    fileData.append('PicDescription', $(this).find('[name="PicDescription"]').val());
				    fileData.append('LinkID', $(this).find('[name="LinkID"]').val());
				    $.ajax({
					    url: '@Url.Action("UploadProfilePhoto", "Profile")',
					    type: "POST",
					    contentType: false, // Not to set any content header
					    processData: false, // Not to process data
						data: fileData,
						async:false,
					    success: function (result) {
						    //alert(result);
					    },
					    error: function (err) {
						    //alert(err.statusText);
					    }
				    });
			    } else {
				    alert("FormData is not supported.");
			    }
		    }

		    // do something with productId, product, Quantity
	    });
        openLifeFriendsWithMeView(1);
    }

