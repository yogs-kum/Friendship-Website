
@model Presentation.Areas.Profile.Models.Mst_ProfileTraits
@{
    ViewBag.Title = "Masker";
    // Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

<div>

    @using (Html.BeginForm("PostDataNeurodiverseStrengths", "Profile", FormMethod.Post, new { id = "frmContactUs10", name = "frmContactUs10", enctype = "multipart/form-data" }))
    {
        <input type="hidden" id="ProfileId" name="ProfileId" value="@Application.Common.clsEncryptDecrypt.Encrypt(ViewBag.ProfileID.ToString())" />

        foreach (var questions in ViewBag.FriendsWithMeList)
        {
                <div class="st-row">
                    <div class="st-row st-direction-column pf-field-cntnr st-flex">

                        <label>@questions.Name</label>
                        <div>
                            <input type="text" id="@questions.Id" name="@questions.Id" value="@questions.Score" maxlength="3" class="pf-input text-box single-line numberonly" onchange="handleChange(this);" />
                            <span class="field-validation-valid text-danger" data-valmsg-for="@questions.Id" data-valmsg-replace="true"></span>
                        </div>
                    </div>
                </div>
         }
            
            <div class="pf-field-cntnr row st-center" style="padding-top:25px;">
                <input type="submit" value="Save &nbsp;&nbsp;&#10095;" class="btn-l btn-primary btn-next" />
            </div>
        }

        <script>
            $(document).ready(function () {
                $('.numberonly').keypress(function (e) {
                    var charCode = (e.which) ? e.which : event.keyCode
                    if (String.fromCharCode(charCode).match(/[^0-9]/g))
                        return false;
                });
            });

            function handleChange(input) {
                if (input.value < 0) input.value = 0;
                if (input.value > 100) input.value = 100;
            }
        </script>

    </div>

