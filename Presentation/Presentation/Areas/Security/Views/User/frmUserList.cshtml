@model IEnumerable<Presentation.Areas.Security.Models.UserModel>
@using GridMvc.Html
@{
    ViewBag.Title = "User";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<main id="main">
    <div class="container-fluid">
        <div class="row p-4">

            <section class="col m-2 p-0 rounded-2 bg-white">

                <div class="d-flex align-items-center justify-content-between py-3 px-4 border-bottom">
                    <h1 class="mb-0 st-heading">@ViewBag.Title</h1>
                    <input type="button" value="Add New" class="btn btn-primary" onclick="location.href='@Url.Action("frmUser","User")'" />
                </div>

                <div class="py-3 px-4">
                    @Html.Grid(Model).Columns(columns =>
                    {
                        columns.Add(c => c.UserId).Titled("User ID").SetWidth(90);
                        columns.Add(c => c.UserName).Titled("User Name").SetWidth(150);
                        columns.Add(c => c.EmailId).Titled("EmailId").SetWidth(150);
                        columns.Add(c => c.OrganizationName).Titled("Organization").SetWidth(150);
                        columns.Add(c => c.Status).Titled("Status").SetWidth(70);
                        columns.Add()
                        .Encoded(false)
                        .Sanitized(false)
                        .SetWidth(30)
                        .RenderValueAs(o => Html.ActionLink("Edit", "frmUser", "User", new { theParameter = Application.Common.clsEncryptDecrypt.Encrypt(o.ID.ToString()) }, new { @class = "btn btn-outline-success st-btn-sm st-btn-edit" }));
                    }).EmptyText("No Data Found.").WithPaging(50).Filterable(true).Sortable(true).WithGridItemsCount("Total Records")
                </div>

            </section>

        </div>
    </div>
</main>