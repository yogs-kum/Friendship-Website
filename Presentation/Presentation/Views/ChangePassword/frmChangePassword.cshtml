@model Presentation.Models.ChangePasswordModels

@{
    ViewBag.Title = "Change Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Change Password</h2>
<hr />
@using (Html.BeginForm("ChangePassword", "ChangePassword", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">

        @Html.ValidationSummary(true)

        <div class="form-group">
            @Html.LabelFor(model => model.theOldPassword, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.PasswordFor(model => model.theOldPassword, new { @class = "form-control", @autofocus = "autofocus" })
                @Html.ValidationMessageFor(model => model.theOldPassword)
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.theNewPassword, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.PasswordFor(model => model.theNewPassword, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.theNewPassword)
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.theConfirmPassword, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.PasswordFor(model => model.theConfirmPassword, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.theConfirmPassword)
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <button type="submit" class="btn btn-primary" onclick="ValidatePassword()"><i class="fa fa-key"></i> Change Password</button>
            </div>
        </div>
    </div>
}
