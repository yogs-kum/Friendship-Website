@section footerSeparate{
    <script src="~/Content/assets/js/liMarquee.js"></script>
    <script>
        $(window).on("load", function () {
            $(".str1").liMarquee({
                direction: "left",
                loop: -1,
                scrolldelay: 0,
                scrollamount: 40,
                circular: true,
                drag: true
            });
        })
        $(window).on("load", function () {
            $(".str2").liMarquee({
                direction: "right",
                loop: -1,
                scrolldelay: 0,
                scrollamount: 12,
                circular: true,
                drag: true
            });
        })
    </script>

    <script>
        $(document).ready(function () {
            $(".expand-btn").on("click", function (e) {
                if ($(this).parent().has(".title-expand-desp")) {
                    e.preventDefault();
                }
                if (!$(this).hasClass("open")) {

                    $(".title-expand-desp").slideUp(350);
                    $(".expand-btn").removeClass("open");

                    $(this).next(".title-expand-desp").slideDown(350);
                    $(this).addClass("open");
                } else if ($(this).hasClass("open")) {
                    $(this).removeClass("open");
                    $(this).next(".title-expand-desp").slideUp(350);
                }
            });
        });
    </script>

    <script>
        $(window).scroll(function () {
            if ($(window).scrollTop() >= $("#sampleProfileSec").offset().top + $("#sampleProfileSec").height() || $(window).scrollTop() < $("#sampleProfileSec").offset().top)
                $("body").removeClass("dark-mode");
            else
                $("body").addClass("dark-mode");
        });
    </script>
}