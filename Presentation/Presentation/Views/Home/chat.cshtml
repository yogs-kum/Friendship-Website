                    <div>I love to play golf</div>
                </div>
                <div class="col-6 px-3 pb-3 text-center">
                    <div class="img-box"><img src="~/Content/assets/images/temp/old-north-church.jpg" alt="image name"></div>
                    <label>A picture in your favorite place</label>
                    <div>I like to visit old churches</div>
                </div>
            </section>
