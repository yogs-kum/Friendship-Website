        @* ======= User Profile Section ======= *@
    <div class="p-0 mdrn-scrollbar" id="userProfileSec">

        <div class="img-box-outer mt-4">
            <div class="img-box">
                <img src="/Content/assets/images/users/user-6.jpg" alt="User Name" class="w-100 h-auto my-match-frnd">
            </div>
        </div>

        <div id="editProfileView" class="mt-lg-2" @*style="flex:1 100px;overflow-y:auto;"*@>
