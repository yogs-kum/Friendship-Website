                    <div class="answer">Yes</div>
                </div>
                <div class="col-12 px-3 pb-4">
                    <label class="question">Going for a motorcycle ride</label>
                    <div class="answer">Yes</div>
                </div>
                <div class="col-12 px-3 pb-4">
                    <label class="question">Go on a hike</label>
                    <div class="answer">Yes</div>
                </div>
                <div class="col-12 px-3 pb-4">
                    <label class="question">Going for a bike ride</label>
                    <div class="answer">Yes</div>
                </div>
                <div class="col-12 px-3 pb-4">
                    <label class="question">Going for a run</label>
                    <div class="answer">No</div>
                </div>
                <div class="col-12 px-3 pb-4">
                    <label class="question">Going for a leisurely walk</label>
                    <div class="answer">Yes</div>
                </div>
                <div class="col-12 px-3 pb-4">
