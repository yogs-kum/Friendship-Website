                    <div class="answer">Yes</div>
                </div>
                <div class="col-12 px-3 pb-4">
                    <label class="question">Watching a live play</label>
                    <div class="answer">Yes</div>
                </div>
                <div class="col-12 px-3 pb-4">
                    <label class="question">Watching a musical live/on TV</label>
