    <script>
        $(window).on("load", function () {
            $("#preloader").fadeOut("slow");
        });

        $(document).ajaxStart(function () {
            setTimeout(function () {
                $("#preloader").show();
            }, 100);
        });
        $(document).ajaxComplete(function () {
            setTimeout(function () {
                $("#preloader").hide();
            }, 3000);
        });

        function fnSelectOrganization() {
            var OrganizationId = $("#lstGlobalOrganizations").val();
            var OrganizationName = $("#lstGlobalOrganizations option:selected").text();
            if (OrganizationId == 0 || OrganizationId == "" || OrganizationId == null || OrganizationId == NaN) {
                alert('Please Select Organization!');
                $("#lstGlobalOrganizations").val(@Session["OrganizationId"]);
                return false;
            }
            var theUrl = '@Url.Action("SwitchOrganization", "Common", new { Area = "" })';
            $.ajax({
                type: "POST",
                url: theUrl,
                data: '{"theOrganizationId":"' + OrganizationId + '","theOrganizationName":"' + OrganizationName + '"}',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (result) {
                    if (result == OrganizationId) {
                        //alert("Organization changed successfully!");
                        window.location = "";
                    }
                    else {
                        alert("Organization not changed, Please try again later!")
                    }
                }
            });
        }
    </script>
    <script>
        $(document).ready(function () {
            $("#asideTriggerHide").on("click", function () {
                $(this).hide();
                $("#asideTriggerShow").show();
                $("#aside,#logo").animate({ left: -250 }, 500);
                $("#main,.static-menu").animate({ marginLeft: 0 }, 500);
                /*$("#logo").css({'background-color':'white', 'width':'auto', 'padding':'0px 10px 0px 20px'});*/
            });
            $("#asideTriggerShow").on("click", function () {
                $(this).hide();
                $("#asideTriggerHide").show();
                $("#aside,#logo").animate({ left: 0 }, 500);
                $("#main,.static-menu").animate({ marginLeft: 250 }, 500);
                /*$("#logo").css({'background-color':'#272d3c', 'width':'250px', 'padding':'0px'});*/
            });

            //Active Navigation
            var current_url = window.location.href.split('?')[0];
            var host = window.location.protocol + "//" + window.location.host;
            var current_href = window.location.href.replace(host, '');

            $(".nav-item").removeClass("active").removeClass("show");
            $("a.sub-link").removeClass("active");

            var a_nav_link = $("a.nav-link");
            a_nav_link.each(function (e) {

                if (this.href.indexOf(current_url) > -1 && $(this).attr("href") != "") {
                    $(this).parents(".nav-item").addClass("active");
                }
            });

            var a_sub_link = $("a.sub-link");
            a_sub_link.each(function (e) {

                if (this.href.indexOf(current_url) > -1 && $(this).attr("href") != "") {
                    $(this).addClass("active");
                    $(this).parents(".nav-item").addClass("active").addClass("show");
                }
            });

            $(".sidebar a.menudisable").parent("li").addClass("menudisable");

        });
    </script>

    @if (Session["ScriptMessage"] != null && Session["ScriptType"] != null)
    {
        var ScriptMessage = Session["ScriptMessage"];
        var ScriptType = Session["ScriptType"];
        Session["ScriptMessage"] = null;
        Session["ScriptType"] = null;
        <script type="text/javascript">
            $(document).ready(function () {
                var type = "@ScriptType";
                if (type == "alert") {
                            alert("@ScriptMessage");
                        }
                        else{
                            return confirm("@ScriptMessage");
                        }
                    });
        </script>
    }

