@model Presentation.Areas.Profile.Models.Profile


@using (Html.BeginForm("SignUp", "Login", FormMethod.Post, new { id = "frmSignUp", name = "frmSignUp", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="mb-3">
        <label class="form-label" for="firstName">Full Name*</label>
        <div class="d-flex">
            <div>
                @Html.EditorFor(model => model.FirstName, new { htmlAttributes = new { @id = "txtFirstName", @type = "text", @placeholder = "First Name", @class = "form-control shadow-none rounded-pill w-100", @style = "border-top-right-radius:0 !important;border-bottom-right-radius:0 !important;", @required = "required" } })
                @Html.ValidationMessageFor(model => model.FirstName, "", new { @class = "text-danger" })
            </div>
            <div>
                @Html.EditorFor(model => model.LastName, new { htmlAttributes = new { @id = "txtLastName", @type = "text", @placeholder = "Last Name", @class = "form-control shadow-none rounded-pill w-100", @style = "border-top-left-radius:0 !important;border-bottom-left-radius:0 !important;" } })
                @Html.ValidationMessageFor(model => model.LastName, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label" for="emailID">Email-ID*</label>
        @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @id = "txtEmail", @type = "email", @placeholder = "Enter your Email-ID", @class = "form-control shadow-none rounded-pill", @required = "required" } })
        @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })

    </div>
    <div class="mb-4">
        <label class="form-label" for="phoneNo">Phone No.</label>
        @Html.EditorFor(model => model.Phone, new { htmlAttributes = new { @id = "txtPhone", @maxLength = "10", @type = "text", @placeholder = "Enter your Phone No.", @class = "form-control shadow-none rounded-pill" } })
        @Html.ValidationMessageFor(model => model.Phone, "", new { @class = "text-danger" })

    </div>
    <button type="submit" name="theParameter" class="btn fw-semibold rounded-pill" onclick="return SaveCall()" value="Save">JOIN US</button>
    @*<button type="submit" class="btn fw-semibold rounded-pill">JOIN US</button>*@

}


@section Scripts {

}
